# ICE LOGIX Mini App - Frontend Environment Variables

# URL бэкенда Go (по умолчанию для локальной разработки: http://localhost:8080)
# На Vercel укажите боевой URL вашего Go бэкенда: например, https://api.icelogix.by
NEXT_PUBLIC_API_URL=http://localhost:8080

# Юзернейм Telegram-бота (без @)
NEXT_PUBLIC_TG_BOT_NAME=ice_logix_bot
